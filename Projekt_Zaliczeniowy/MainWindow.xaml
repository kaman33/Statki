<Window x:Class="Projekt_Zaliczeniowy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projekt_Zaliczeniowy"
        xmlns:viewModels="clr-namespace:Projekt_Zaliczeniowy.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="560" Width="1120">
    <Window.DataContext>
        <viewModels:GraViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="PolePlanszyButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PoleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PoleBorder" Property="BorderBrush" Value="Green"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,8,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="2"
                   FontSize="18"
                   Margin="0,0,0,8"
                   HorizontalAlignment="Center"
                   Text="{Binding Status}"/>
        
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Text="Twoja plansza"/>
            <Viewbox Stretch="Uniform">
                <ItemsControl Width="500"
                              Height="500"
                              ItemsSource="{Binding PolaGracza}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="10" Columns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:PolePlanszyViewModel}">
                            <Button Style="{StaticResource PolePlanszyButtonStyle}"
                                    Margin="2"
                                    Background="{Binding Kolor}"
                                    IsHitTestVisible="False"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Viewbox>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Text="Plansza przeciwnika"/>
            <Viewbox Stretch="Uniform">
                <ItemsControl Width="500"
                              Height="500"
                          ItemsSource="{Binding PolaPrzeciwnika}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="10" Columns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:PolePlanszyViewModel}">
                            <Button Style="{StaticResource PolePlanszyButtonStyle}"
                                    Margin="2"
                                    Background="{Binding Kolor}"
                                    Command="{Binding DataContext.StrzelCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Viewbox>
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Gra"/>
                <TextBlock Margin="0,6,0,0">
                    <Run Text="Tryb: "/>
                    <Run Text="{Binding TrybGryOpis, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Margin="0,6,0,0">
                    <Run Text="Tura: "/>
                    <Run Text="{Binding AktualnaTura, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Margin="0,6,0,0">
                    <Run Text="Strzaly: "/>
                    <Run Text="{Binding LiczbaStrzalow, Mode=OneWay}"/>
                </TextBlock>
                <Button Style="{StaticResource PanelButtonStyle}"
                        Content="Nowa gra"
                        Command="{Binding NowaGraCommand}"/>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Tryb"/>
                <Button Style="{StaticResource PanelButtonStyle}"
                        Content="Gra z botem"
                        Command="{Binding TrybBotCommand}"/>
                <Button Style="{StaticResource PanelButtonStyle}"
                        Content="Multiplayer"
                        Command="{Binding TrybMultiplayerCommand}"/>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Siec"/>
                <TextBlock Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding StatusSieci}"/>
                <Button Style="{StaticResource PanelButtonStyle}"
                        Content="Polacz"
                        Command="{Binding PolaczCommand}"/>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Historia"/>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      Margin="0,8,0,0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      ItemsSource="{Binding HistoriaGier}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data"
                                        Binding="{Binding PlayedAt, StringFormat={}{0:dd.MM HH:mm}}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Zwyciezca"
                                        Binding="{Binding Winner}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Strzaly"
                                        Binding="{Binding ShotCount}"
                                        Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        
    </Grid>
</Window>
