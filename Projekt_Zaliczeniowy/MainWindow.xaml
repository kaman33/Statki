<Window x:Class="Projekt_Zaliczeniowy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Projekt_Zaliczeniowy.ViewModels"
        mc:Ignorable="d"
        Title="Statki" Height="860" Width="1480"
        MinHeight="860" MinWidth="1220"
        Background="#FAFAF8">
    <Window.DataContext>
        <viewModels:GraViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="GridLineBrush" Color="#9EA6FF"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8B929C"/>
        <SolidColorBrush x:Key="MainTextBrush" Color="#111827"/>

        <Style x:Key="BoardCellButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0.8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="64"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PoleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid ClipToBounds="True">
                                <TextBlock x:Name="PoleSymbol"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           FontFamily="Segoe UI Symbol"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           LineHeight="58"
                                           LineStackingStrategy="BlockLineHeight"
                                           Margin="0,-8,0,0"/>
                                <Canvas x:Name="PoleCross"
                                        Width="50"
                                        Height="50"
                                        Visibility="Collapsed">
                                    <Line X1="4"
                                          Y1="4"
                                          X2="46"
                                          Y2="46"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="2"/>
                                    <Line X1="46"
                                          Y1="4"
                                          X2="4"
                                          Y2="46"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="2"/>
                                </Canvas>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="PoleSymbol" Property="Text" Value="•">
                                <Setter TargetName="PoleSymbol" Property="FontSize" Value="28"/>
                                <Setter TargetName="PoleSymbol" Property="LineHeight" Value="28"/>
                                <Setter TargetName="PoleSymbol" Property="Margin" Value="0,-4,0,0"/>
                            </Trigger>
                            <Trigger SourceName="PoleSymbol" Property="Text" Value="×">
                                <Setter TargetName="PoleSymbol" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PoleCross" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PoleBorder" Property="Background" Value="#FFFDEB"/>
                                <Setter TargetName="PoleBorder" Property="BorderBrush" Value="#FF6B3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CoordinateTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PanelButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>

        <DataTemplate x:Key="FleetItemTemplate" DataType="{x:Type viewModels:FlotaViewModel}">
            <TextBlock Text="{Binding Segmenty}"
                       Foreground="{Binding Kolor}"
                       FontSize="14"
                       Margin="5,0,5,3"/>
        </DataTemplate>

        <DataTemplate x:Key="FleetRowTemplate">
            <ItemsControl ItemsSource="{Binding}"
                          ItemTemplate="{StaticResource FleetItemTemplate}"
                          HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="286"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,22">
            <TextBlock Text="Statki"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MainTextBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Status}"
                       FontSize="15"
                       Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,28,0" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding FlotaGraczaWedlugRzedow}"
                          ItemTemplate="{StaticResource FleetRowTemplate}"
                          HorizontalAlignment="Center"
                          Margin="26,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

                <Viewbox Stretch="Uniform">
                    <Grid Width="536" Height="536">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="500"/>
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="500"/>
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>

                    <UniformGrid Grid.Row="0" Grid.Column="1" Columns="10">
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="A"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="B"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="C"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="D"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="E"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="F"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="G"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="H"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="I"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="J"/>
                    </UniformGrid>

                    <UniformGrid Grid.Row="1" Grid.Column="0" Rows="10">
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="1"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="2"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="3"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="4"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="5"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="6"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="7"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="8"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="9"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="10"/>
                    </UniformGrid>

                    <ItemsControl Grid.Row="1" Grid.Column="1"
                                  Width="500"
                                  Height="500"
                                  ItemsSource="{Binding PolaGracza}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="10" Columns="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:PolePlanszyViewModel}">
                                <Button Style="{StaticResource BoardCellButtonStyle}"
                                        Background="{Binding Kolor}"
                                        Foreground="{Binding KolorSymbolu}"
                                        Content="{Binding Symbol}"
                                        IsHitTestVisible="False"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                </Viewbox>
                <TextBlock Text="Twoje boisko"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="15"
                           Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,28,0" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding FlotaPrzeciwnikaWedlugRzedow}"
                          ItemTemplate="{StaticResource FleetRowTemplate}"
                          HorizontalAlignment="Center"
                          Margin="26,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

                <Viewbox Stretch="Uniform">
                    <Grid Width="536" Height="536">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="500"/>
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="500"/>
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>

                    <UniformGrid Grid.Row="0" Grid.Column="1" Columns="10">
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="A"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="B"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="C"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="D"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="E"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="F"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="G"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="H"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="I"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="J"/>
                    </UniformGrid>

                    <UniformGrid Grid.Row="1" Grid.Column="0" Rows="10">
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="1"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="2"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="3"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="4"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="5"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="6"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="7"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="8"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="9"/>
                        <TextBlock Style="{StaticResource CoordinateTextStyle}" Text="10"/>
                    </UniformGrid>

                    <ItemsControl Grid.Row="1" Grid.Column="1"
                                  Width="500"
                                  Height="500"
                                  ItemsSource="{Binding PolaPrzeciwnika}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="10" Columns="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:PolePlanszyViewModel}">
                                <Button Style="{StaticResource BoardCellButtonStyle}"
                                        Background="{Binding Kolor}"
                                        Foreground="{Binding KolorSymbolu}"
                                        Content="{Binding Symbol}"
                                        Command="{Binding DataContext.StrzelCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                </Viewbox>
                <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="Boisko przeciwnika"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource MainTextBrush}"
                               FontSize="15"/>
                    <TextBlock Text="strzelaj tutaj"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontStyle="Italic"
                               FontSize="12"/>
                </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="2"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" Text="Gra"/>
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0">
                        <Run Text="Tryb: "/>
                        <Run Text="{Binding TrybGryOpis, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0">
                        <Run Text="Tura: "/>
                        <Run Text="{Binding AktualnaTuraOpis, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,8">
                        <Run Text="Strzały: "/>
                        <Run Text="{Binding LiczbaStrzalow, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Style="{StaticResource PanelButtonStyle}"
                            Content="Nowa gra"
                            Command="{Binding NowaGraCommand}"/>

                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Tryb"/>
                    <Button Style="{StaticResource PanelButtonStyle}"
                            Content="Gra z botem"
                            Command="{Binding TrybBotCommand}"/>
                    <Button Style="{StaticResource PanelButtonStyle}"
                            Content="Multiplayer"
                            Command="{Binding TrybMultiplayerCommand}"/>

                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Sieć"/>
                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,5,0,2"
                               Text="Adres serwera"/>
                    <TextBox Text="{Binding ServerHost, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,5"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"/>
                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,7,0,2"
                               Text="Port"/>
                    <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,5"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"/>
                    <TextBlock Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding StatusSieci}"/>
                    <Button Style="{StaticResource PanelButtonStyle}"
                            Content="Połącz"
                            Command="{Binding PolaczCommand}"/>

                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Historia"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          Margin="0,10,0,0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          BorderBrush="#E5E7EB"
                          BorderThickness="1"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          ItemsSource="{Binding HistoriaGier}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data"
                                            Binding="{Binding PlayedAt, StringFormat={}{0:dd.MM HH:mm}}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Zwycięzca"
                                            Binding="{Binding Winner}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Strzały"
                                            Binding="{Binding ShotCount}"
                                            Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
